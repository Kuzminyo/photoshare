# --- database (docker-compose) ---
POSTGRES_DB=photoshare
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5440
# used when the app runs locally (outside Docker); docker-compose overrides it
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5440/photoshare

# --- app ---
APP_PORT=8080
BASE_URL=http://localhost:8080
# generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:3000

# --- Cloudinary (https://console.cloudinary.com -> API Keys) ---
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
